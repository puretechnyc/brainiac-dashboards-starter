# Copy this file to `.env` (same folder) and fill in what you use.
# NEVER commit .env (it is in .gitignore). Nothing here is needed for the demo.

# ---- Meta (Facebook / Instagram) ads ----
# A token with ads_read for your ad accounts. Best: a System User token
# (Business Settings > Users > System users > Generate token, tick ads_read).
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# ---- Google Ads ----
# Developer token: Google Ads manager account > Tools > API Center
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth client (Google Cloud console > APIs & Services > Credentials > "Desktop app")
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Refresh token for a Google user who can see the ad accounts
GOOGLE_ADS_REFRESH_TOKEN=
# Your manager (MCC) account id, digits only. Leave empty if you have no manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21
